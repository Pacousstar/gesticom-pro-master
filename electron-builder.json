{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.gsn.gesticom-pro",
  "productName": "GestiCom Pro",
  "copyright": "Copyright © 2026 GSN EXPERTISES GROUP",
  "directories": {
    "output": "release"
  },
  "files": [
    ".next/**/*",
    "electron/**/*",
    "public/**/*",
    "prisma/**/*",
    "package.json",
    "scripts/**/*",
    "node_modules/**/*",
    "!release/**",
    "!node_modules/.cache/**",
    "!node_modules/typescript/**",
    "!node_modules/vitest/**",
    "!node_modules/eslint*/**",
    "!node_modules/@types*/**",
    "!node_modules/playwright/**",
    "!node_modules/tsx/**",
    "!node_modules/prettier*/**",
    "!node_modules/electron/**",
    "!node_modules/concurrently/**",
    "!node_modules/wait-on/**",
    "!node_modules/electron-builder/**",
    "!node_modules/app-builder-lib/**",
    "!node_modules/builder-util*/**",
    "!node_modules/dmg-builder/**",
    "!node_modules/7zip-bin/**",
    "!node_modules/electron-updater/**",
    "!node_modules/electron-dl/**",
    "!node_modules/electron-is-dev/**"
  ],
  "extraResources": [
    {
      "from": "node_modules/@prisma/client-pg",
      "to": "app.asar.unpacked/node_modules/@prisma/client-pg",
      "filter": ["**/*", "!**/*.tmp*"]
    }
  ],
  "asar": true,
  "asarUnpack": [
    "node_modules/@prisma/**",
    "node_modules/prisma/**",
    "node_modules/.prisma/**",
    "node_modules/bcryptjs/**",
    "prisma/**",
    "scripts/**"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "public/gesticom.ico",
    "artifactName": "${productName}-v${version}-Setup.${ext}"
  },
  "npmRebuild": false,
  "nodeGypRebuild": false,
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "GestiCom Pro",
    "installerIcon": "public/gesticom.ico",
    "uninstallerIcon": "public/gesticom.ico",
    "runAfterFinish": true
  },
  "mac": {
    "target": ["dmg", "zip"],
    "icon": "public/images/icon.png",
    "artifactName": "${productName}-v${version}-${arch}.${ext}",
    "category": "public.app-category.business"
  },
  "linux": {
    "target": ["AppImage", "deb"],
    "icon": "public/images/icon.png",
    "artifactName": "${productName}-v${version}-${arch}.${ext}",
    "category": "Office"
  }
}
